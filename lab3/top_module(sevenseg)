module SevenSeg(
    input [3:0] A,
    input [3:0] B,
    input s,
    output [6:0] seg,
    output [3:0] an
    );
    wire [3:0] bcd_mux_out;
    wire [3:0] sum;
    wire cout;
    
    
    CLAA uut1(.A(A), .B(B), .Cin(1'b0),.s(sum),.cout(cout));
    BCD uut2(.bcd(bcd_mux_out), .seg(seg));
    MuxTwo uut3 (.A(sum), .B(A), .sel(s), .mux_out(bcd_mux_out));
    
    assign an = 4'b1110;
    
endmodule
