module comb_multiplier(
    input [3:0] A,
    input [3:0] B,
    output [7:0] i_write_data   
   );

wire [3:0] pp0;
wire [4:0] pp1;
wire [5:0] pp2;
wire [6:0] pp3;



assign pp0 = B[0] ? A: 0;
assign pp1 = B[1] ? A<<1: 0;
assign pp2 = B[2] ? A<<2: 0;
assign pp3 = B[3] ? A<<3: 0;

assign i_write_data = pp0 + pp1 + pp2 + pp3;



endmodule
